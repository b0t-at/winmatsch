<Project>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <Deterministic>true</Deterministic>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- AOT readiness: keep everything trimmer- and AOT-analyzable from day one. -->
    <IsAotCompatible Condition="'$(IsTestProject)' != 'true'">true</IsAotCompatible>
    <RootNamespace>$(MSBuildProjectName)</RootNamespace>
  </PropertyGroup>

  <PropertyGroup>
    <Product>binmatch</Product>
    <Authors>binmatch contributors</Authors>
    <Copyright>Copyright (c) 2026 binmatch contributors</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/b0t-at/binmatch</RepositoryUrl>
    <PackageProjectUrl>https://github.com/b0t-at/binmatch</PackageProjectUrl>
    <VersionPrefix>1.0.0</VersionPrefix>
  </PropertyGroup>

</Project>
