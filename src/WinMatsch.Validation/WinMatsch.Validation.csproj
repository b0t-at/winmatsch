<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Cross-platform validation and preflight gates for complete WinGet manifest submissions.</Description>
    <!-- JsonSchema.Net 8.0.5 declares IsAotCompatible for net7+; keep its call surface under trim/AOT analyzers. -->
    <WarningsAsErrors>$(WarningsAsErrors);IL2026;IL3000;IL3002;IL3050</WarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="JsonSchema.Net" />
    <PackageReference Include="YamlDotNet" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WinMatsch.Core\WinMatsch.Core.csproj" />
    <ProjectReference Include="..\WinMatsch.Downloads\WinMatsch.Downloads.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\schemas\manifest.*.1.12.0.json"
                      LogicalName="WinMatsch.Validation.Schemas.%(Filename)%(Extension)" />
    <None Include="..\..\THIRD-PARTY-NOTICES.txt"
          Link="THIRD-PARTY-NOTICES.txt"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
